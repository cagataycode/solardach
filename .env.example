# --- Database (SQLite for dev; use Postgres in production, EU region) ---
DATABASE_URL="file:./dev.db"

# --- Roof data sources ---
# Optional: Google Solar API key. If unset, the app falls back to
# OSM footprint heuristics and region defaults automatically.
GOOGLE_SOLAR_API_KEY=""

# --- German economics assumptions (configurable, NOT hardcoded) ---
# Household electricity price in ct/kWh
ASSUMPTION_ELECTRICITY_PRICE_CT_KWH="30"
# EEG Einspeisevergütung (partial feed-in, <10 kWp) in ct/kWh — subject to degression, review quarterly
ASSUMPTION_FEED_IN_TARIFF_CT_KWH="7.9"
# Self-consumption share without battery (0..1)
ASSUMPTION_SELF_CONSUMPTION_SHARE="0.30"
# Turnkey system cost per kWp in EUR at 0% VAT (range)
ASSUMPTION_SYSTEM_COST_PER_KWP_EUR_LOW="1300"
ASSUMPTION_SYSTEM_COST_PER_KWP_EUR_HIGH="1800"

# --- Pilot region ---
# Restrict address checks to these German postcode prefixes (empty = all of DE)
PILOT_POSTCODE_PREFIXES=""
